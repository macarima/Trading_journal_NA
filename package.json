{
  "name": "trading-journal",
  "version": "1.0.2",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "electron:dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "electron:build": "vite build && electron-builder",
    "electron:build:mac": "vite build && electron-builder --mac",
    "electron:build:win": "vite build && electron-builder --win"
  },
  "build": {
    "appId": "com.trading.journal",
    "productName": "Trading Journal",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "extraResources": [
      { "from": "data/", "to": "data/", "filter": ["**/*"] }
    ],
    "mac": {
      "category": "public.app-category.finance",
      "target": "dmg",
      "icon": null
    },
    "win": {
      "target": "portable",
      "icon": null
    },
    "portable": {
      "artifactName": "TradingJournal-${version}-portable.exe"
    }
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^8.2.2",
    "electron": "^31.3.1",
    "electron-builder": "^24.13.3",
    "vite": "^5.4.2",
    "wait-on": "^7.2.0"
  }
}
